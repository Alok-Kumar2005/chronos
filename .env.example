# Database Configuration
# Main database URL - Neon Postgres with SSL required
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Test database URL - MUST be different from DATABASE_URL
# Tests will refuse to run if this equals DATABASE_URL
TEST_DATABASE_URL=postgresql://user:password@host-test.neon.tech/database?sslmode=require

# Groq API Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_api_key_here

# Primary model for complex reasoning (scenario generation, bug analysis)
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile

# Fast model for simple tasks (validation, classification)
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Application Configuration
# Public base URL for webhook callbacks and links
PUBLIC_BASE_URL=http://localhost:8000

# Base64-encoded signing key for webhook signatures (auto-generated if missing)
# SIGNING_KEY_B64=

# Universe TTL in real days (virtual tenants expire after this period)
UNIVERSE_TTL_DAYS=7

# Environment (dev|test|prod)
ENV=dev

# Optional: PayPal sandbox credentials (for reality checks in later steps)
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
